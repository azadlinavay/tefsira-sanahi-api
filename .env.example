APP_NAME="Tefsira Sanahi API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# The public address of this API; clip and package URLs are built from it.
APP_URL=http://tefsira-sanahi-api.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local: SQLite (zero setup). Production (Forge): MySQL.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=tefsira_sanahi
# DB_USERNAME=forge
# DB_PASSWORD=

SESSION_DRIVER=array
CACHE_STORE=database
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# --- Tefsira Sanahi -----------------------------------------------------

# Bearer token for /api/v1/admin/* (text corrections, audio uploads).
# Generate one: php -r "echo bin2hex(random_bytes(32));"
# Leave empty to switch the admin endpoints off.
TEFSIRA_ADMIN_TOKEN=

# Where tafsir audio and the downloadable zips live:
#   public = on this server (storage/app/public, run php artisan storage:link)
#   s3     = S3-compatible storage such as Cloudflare R2 (fill in AWS_* below)
TEFSIRA_AUDIO_DISK=public
TEFSIRA_PACKAGES_DISK=public

# Requests per minute per IP, and Cache-Control max-age for public reads.
TEFSIRA_RATE_LIMIT=120
TEFSIRA_CACHE_SECONDS=3600

# Cloudflare R2 (or any S3-compatible storage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=tefsira-sanahi
# https://<account-id>.r2.cloudflarestorage.com
AWS_ENDPOINT=
# The bucket's public URL (r2.dev or your custom domain), e.g. https://audio.example.com
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true
